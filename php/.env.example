# Copie para .env (desenvolvimento/servidor próprio) ou cadastre como variáveis de ambiente.
# Banco MySQL 8 — use DATABASE_URL OU as variáveis DB_*.
DATABASE_URL=mysql://usuario:senha@host:3306/pallet
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=pallet
# DB_USER=pallet
# DB_PASS=
# Certificado da autoridade para conexão TLS com o MySQL gerenciado (opcional).
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Segredo da sessão (mínimo 32 caracteres). Gere com: php -r "echo bin2hex(random_bytes(32));"
AUTH_SECRET=

# Usuário MASTER criado pelo seed (opcional; padrão admin / admin123).
# SEED_ADMIN_LOGIN=admin
# SEED_ADMIN_PASSWORD=
