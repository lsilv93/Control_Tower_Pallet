// Sistema de Gestão de Pallets PBR
// Banco relacional PostgreSQL (Neon / Vercel Postgres em produção)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// MASTER: tudo, inclusive ajuste manual de saldos. ADMIN: tudo, exceto ajuste manual.
/// OPERADOR: somente as telas/funcionalidades marcadas em `permissoes`.
enum Perfil {
  MASTER
  ADMIN
  OPERADOR
}

/// Contas da conta corrente de pallets (partida dobrada). Toda movimentação tem
/// uma conta de origem e uma de destino; nenhum pallet surge ou some sem contrapartida.
/// Estoques físicos: VAZIOS, CD e QUEBRADOS. As demais são contrapartidas externas.
enum Conta {
  VAZIOS     // estoque de pallets vazios (pulmão)
  CD         // estoque do Centro de Distribuição
  QUEBRADOS  // estoque de pallets quebrados
  FORNECEDOR // pallets recebidos de / devolvidos a fornecedores (vales-pallet)
  COMPRA     // aquisição de pallets novos
  DESCARTE   // baixa definitiva (destruição)
  AJUSTE     // lançamento manual do usuário MASTER
}

/// Tipos de movimentação da conta corrente de pallets.
enum TipoMovimentacao {
  ENVIO_CD               // saída do pulmão para um CD
  RECEBIMENTO_CD         // entrada no pulmão vinda de um CD
  RECEBIMENTO_FORNECEDOR // entrada no pulmão vinda de fornecedor (gera vale-pallet)
  DEVOLUCAO_FORNECEDOR   // saída do pulmão na baixa de uma agenda de devolução
  QUEBRA                 // saída do pulmão para o estoque de avariados
  RECUPERADO             // retorno do estoque de avariados para o pulmão
  DESCARTE               // baixa definitiva do estoque de avariados
  AJUSTE_ENTRADA         // ajuste de inventário (entrada)
  AJUSTE_SAIDA           // ajuste de inventário (saída)
  COMPRA                 // compra de pallets novos (entrada via NF-e)
  ESTORNO_VALE           // estorno da entrada de um vale cancelado (saída do pulmão)
}

enum StatusVale {
  PENDENTE
  AGENDADO
  FINALIZADO
  CANCELADO
}

/// Motivos aceitos para exclusão (cancelamento) de um vale emitido incorretamente.
enum MotivoCancelamento {
  FORNECEDOR_INCORRETO
  TRANSPORTADORA_INCORRETA
  QUANTIDADE_INCORRETA
  DOCUMENTO_ERRADO
}

enum StatusAgenda {
  ABERTA
  VALIDADA
  CANCELADA
}

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  login        String   @unique
  senhaHash    String
  perfil       Perfil   @default(OPERADOR)
  /// Permissões granulares por tela/funcionalidade (usadas pelo perfil OPERADOR).
  permissoes   String[] @default([])
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  movimentacoes    Movimentacao[]
  valesCriados     ValePallet[]      @relation("ValeCriadoPor")
  valesCancelados  ValePallet[]      @relation("ValeCanceladoPor")
  agendasCriadas   AgendaDevolucao[] @relation("AgendaCriadaPor")
  agendasValidadas AgendaDevolucao[] @relation("AgendaValidadaPor")
  auditorias       Auditoria[]
  compras          Compra[]
}

model CentroDistribuicao {
  id       String   @id @default(cuid())
  codigo   String   @unique
  nome     String
  cidade      String? // localização
  responsavel String?
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())

  movimentacoes Movimentacao[]
}

model Fornecedor {
  id       String   @id @default(cuid())
  nome     String
  cnpj     String   @unique // normalizado: 14 caracteres (numérico ou alfanumérico)
  endereco String?
  cidade   String?
  uf       String?
  contato  String?
  telefone String?
  email    String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  vales         ValePallet[]
  movimentacoes Movimentacao[]
  agendas       AgendaDevolucao[]
  compras       Compra[]
}

model Transportadora {
  id       String   @id @default(cuid())
  nome     String
  cnpj     String   @unique
  contato  String?
  telefone String?
  email    String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())
}

/// Compra de pallets novos, identificada pela chave de acesso da NF-e
/// (código de barras do DANFE).
model Compra {
  id           String   @id @default(cuid())
  chaveAcesso  String   @unique
  notaFiscal   String
  serie        String
  fornecedorId String
  quantidade   Int
  observacao   String?
  criadoEm     DateTime @default(now())
  usuarioId    String

  fornecedor    Fornecedor     @relation(fields: [fornecedorId], references: [id])
  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  movimentacoes Movimentacao[]
}

/// Vale-pallet: documento gerado no recebimento de fornecedor. Representa
/// pallets que o pulmão deve devolver ao fornecedor.
model ValePallet {
  id             String     @id @default(cuid())
  numero         Int        @unique @default(autoincrement())
  fornecedorId   String
  transportadora String
  placa          String
  /// Número da NF (sem zeros à esquerda). Nulo quando o recebimento é "Sem Nota Fiscal".
  notaFiscal     String?
  serieNf        String?
  /// Chave de acesso da NF-e lida no código de barras (impede lançar a mesma NF duas vezes).
  chaveNfe       String?    @unique
  semNotaFiscal  Boolean    @default(false)
  conferente     String?
  quantidade     Int
  status         StatusVale @default(PENDENTE)
  observacao     String?
  criadoEm       DateTime   @default(now())
  criadoPorId    String
  agendaId       String?
  finalizadoEm   DateTime?
  // Exclusão lógica: o vale é mantido para auditoria com status CANCELADO.
  canceladoEm            DateTime?
  canceladoPorId         String?
  motivoCancelamento     MotivoCancelamento?
  observacaoCancelamento String?

  fornecedor    Fornecedor       @relation(fields: [fornecedorId], references: [id])
  criadoPor     Usuario          @relation("ValeCriadoPor", fields: [criadoPorId], references: [id])
  canceladoPor  Usuario?         @relation("ValeCanceladoPor", fields: [canceladoPorId], references: [id])
  agenda        AgendaDevolucao? @relation(fields: [agendaId], references: [id])
  movimentacoes Movimentacao[]

  @@index([status])
  @@index([fornecedorId, status])
}

/// Agenda de devolução: agrupa vales de um fornecedor para devolução.
/// Ao ser validada (baixa de pagamento), os vales são finalizados e os
/// pallets saem oficialmente da conta corrente.
model AgendaDevolucao {
  id              String       @id @default(cuid())
  numero          Int          @unique @default(autoincrement())
  fornecedorId    String
  dataPrevista    DateTime
  status          StatusAgenda @default(ABERTA)
  observacao      String?
  criadoEm        DateTime     @default(now())
  criadoPorId     String
  validadoEm      DateTime?
  validadoPorId   String?
  canceladoEm     DateTime?

  fornecedor    Fornecedor     @relation(fields: [fornecedorId], references: [id])
  criadoPor     Usuario        @relation("AgendaCriadaPor", fields: [criadoPorId], references: [id])
  validadoPor   Usuario?       @relation("AgendaValidadaPor", fields: [validadoPorId], references: [id])
  vales         ValePallet[]
  movimentacoes Movimentacao[]

  @@index([status])
}

/// Livro-razão da conta corrente. Cada linha guarda a variação aplicada ao
/// saldo do pulmão e ao estoque de avariados, com data/hora e usuário.
model Movimentacao {
  id           String           @id @default(cuid())
  tipo         TipoMovimentacao
  quantidade   Int
  origem       Conta
  destino      Conta
  observacao   String?
  criadoEm     DateTime         @default(now())
  usuarioId    String
  cdId         String?
  fornecedorId String?
  valeId       String?
  agendaId     String?
  compraId     String?

  usuario    Usuario             @relation(fields: [usuarioId], references: [id])
  compra     Compra?             @relation(fields: [compraId], references: [id])
  cd         CentroDistribuicao? @relation(fields: [cdId], references: [id])
  fornecedor Fornecedor?         @relation(fields: [fornecedorId], references: [id])
  vale       ValePallet?         @relation(fields: [valeId], references: [id])
  agenda     AgendaDevolucao?    @relation(fields: [agendaId], references: [id])

  @@index([criadoEm])
  @@index([tipo, criadoEm])
  @@index([origem])
  @@index([destino])
}

/// Trilha de auditoria de todas as ações do sistema (movimentações,
/// cadastros, agendas, login etc.).
/// Log imutável (triggers no banco bloqueiam UPDATE/DELETE).
model Auditoria {
  id         String   @id @default(cuid())
  acao       String
  entidade   String
  entidadeId String?
  origem     Conta?
  destino    Conta?
  quantidade Int?
  observacao String?
  detalhes   Json?
  criadoEm   DateTime @default(now())
  usuarioId  String?

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([criadoEm])
  @@index([acao])
  @@index([usuarioId])
}

/// Tokens de sessão encerrados pelo botão Sair. Mesmo que alguém tenha uma cópia
/// do cookie, o token deixa de valer. Registros expirados são limpos no logout.
model SessaoRevogada {
  jti       String   @id
  usuarioId String
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@index([expiraEm])
}
