// Sistema de Gestão de Pallets PBR — Torre de Controle Nível Brasil
// Banco relacional PostgreSQL (Neon / Vercel Postgres em produção)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// MASTER: tudo (inclusive configurações). ADMIN: tudo, exceto configurações exclusivas do Master.
/// OPERADOR: somente as telas marcadas em `permissoes`, na sua unidade.
enum Perfil {
  MASTER
  ADMIN
  OPERADOR
}

/// CD (inclusive o Hub CDJC) ou Ponto de Cross-Docking. Todos têm estoque próprio.
enum TipoUnidade {
  CD
  CROSS
}

/// Contas da conta corrente (partida dobrada), sempre no livro de uma unidade.
/// Estoques físicos (nunca negativos): VAZIOS (pallets bons) e QUEBRADOS.
/// TRANSITO: enviados pela unidade e ainda não conferidos no destino.
/// OCORRENCIA: faltas apuradas na conferência, pendentes de devolução à unidade remetente.
/// As demais são contrapartidas externas.
enum Conta {
  VAZIOS
  QUEBRADOS
  TRANSITO
  OCORRENCIA
  ENVIADO    // transferido a outra unidade (baixa do trânsito na conferência)
  RECEBIDO   // recebido de outra unidade
  SOBRA      // recebido a mais que o declarado no vale
  PERDA      // falta baixada como perda
  DESCARTE   // descartados/destruídos (inclusive os usados no reparo)
  AJUSTE     // inclusões e remoções manuais de administrador
  COMPRA     // compra de pallets novos (NF-e)
  FORNECEDOR // fornecedores (módulo Recebimento Pallet Fornecedor)
  CARGA      // pallets carregados recebidos de fornecedores
}

enum TipoMovimentacao {
  ENVIO                  // unidade origem: Vazios/Quebrados → Trânsito
  BAIXA_TRANSITO         // unidade origem: Trânsito → Enviado (conferido no destino)
  RECEBIMENTO            // unidade destino: Recebido → Vazios/Quebrados
  FALTA                  // unidade origem: Trânsito → Ocorrência
  SOBRA                  // unidade destino: Sobra → Vazios/Quebrados
  OCORRENCIA_LOCALIZADA  // unidade origem: Ocorrência → Vazios/Quebrados
  OCORRENCIA_PERDA       // unidade origem: Ocorrência → Perda
  ESTORNO_ENVIO          // unidade origem: Trânsito → Vazios/Quebrados (vale excluído antes da conferência)
  QUEBRA                 // Vazios → Quebrados
  RECUPERADO             // Quebrados → Vazios (reparo no Hub)
  CANIBALIZACAO          // Quebrados → Descarte (usados no reparo)
  DESCARTE               // Vazios/Quebrados → Descarte
  INCLUSAO_MANUAL        // Ajuste → Vazios/Quebrados (motivo)
  REMOCAO_MANUAL         // Vazios/Quebrados → Ajuste
  COMPRA                 // Compra → Vazios
  RECEBIMENTO_FORNECEDOR // Fornecedor → Carga
  DEVOLUCAO_FORNECEDOR   // Vazios → Fornecedor
  ESTORNO_VALE           // Carga → Fornecedor
}

enum TipoVale {
  ENVIO      // transferência entre unidades (bons e/ou quebrados)
  OCORRENCIA // falta ou sobra apurada na conferência
  FORNECEDOR // recebimento de fornecedor
}

enum TipoOcorrencia {
  FALTA
  SOBRA
}

enum ResolucaoOcorrencia {
  LOCALIZADA // pallets localizados e devolvidos à unidade remetente
  PERDA      // baixada como perda
}

enum StatusVale {
  PENDENTE   // envio: em trânsito; ocorrência de falta: aberta; fornecedor: a devolver
  AGENDADO   // fornecedor: retirada agendada
  FINALIZADO // envio: conferido; ocorrência: resolvida/registrada; fornecedor: baixado
  CANCELADO
}

enum MotivoCancelamento {
  FORNECEDOR_INCORRETO
  TRANSPORTADORA_INCORRETA
  QUANTIDADE_INCORRETA
  DOCUMENTO_ERRADO
  DESTINO_INCORRETO
}

enum StatusAgenda {
  ABERTA
  VALIDADA
  CANCELADA
}

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  login        String   @unique
  senhaHash    String
  perfil       Perfil   @default(OPERADOR)
  /// Permissões granulares por tela/funcionalidade (perfil OPERADOR).
  permissoes   String[] @default([])
  /// Unidade (CD ou Ponto de Cross) à qual o usuário pertence.
  unidadeId    String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  unidade          CentroDistribuicao @relation("UsuarioUnidade", fields: [unidadeId], references: [id])
  movimentacoes    Movimentacao[]
  conferencias     Conferencia[]
  valesCriados     ValePallet[]      @relation("ValeCriadoPor")
  valesCancelados  ValePallet[]      @relation("ValeCanceladoPor")
  valesResolvidos  ValePallet[]      @relation("ValeResolvidoPor")
  agendasCriadas   AgendaDevolucao[] @relation("AgendaCriadaPor")
  agendasValidadas AgendaDevolucao[] @relation("AgendaValidadaPor")
  auditorias       Auditoria[]
  compras          Compra[]

  @@index([unidadeId])
}

/// Unidade: CD (o Hub CDJC tem `hub = true`) ou Ponto de Cross (vinculado a um CD regional).
model CentroDistribuicao {
  id       String      @id @default(cuid())
  codigo   String      @unique
  nome     String
  tipo     TipoUnidade @default(CD)
  /// CD Hub principal (CDJC): visão Nível Brasil, recebe quebrados das filiais e faz o conserto.
  hub      Boolean     @default(false)
  cnpj     String?     @unique
  contato  String?
  telefone String?
  email    String?
  /// Pontos de Cross: CD da região a que o Cross pertence.
  cdRegionalId String?
  /// Módulo "Recebimento Pallet Fornecedor" liberado para este CD (configuração do Master).
  recebimentoFornecedor Boolean @default(false)
  ativo    Boolean     @default(true)
  criadoEm DateTime    @default(now())

  cdRegional    CentroDistribuicao?  @relation("CrossRegional", fields: [cdRegionalId], references: [id])
  crosses       CentroDistribuicao[] @relation("CrossRegional")
  usuarios      Usuario[]            @relation("UsuarioUnidade")
  movimentacoes        Movimentacao[]  @relation("MovimentacaoCD")
  movimentacoesUnidade Movimentacao[]  @relation("MovimentacaoUnidade")
  vales                ValePallet[]    @relation("ValeCD")
  valesDestino         ValePallet[]    @relation("ValeUnidade")
  conferencias         Conferencia[]   @relation("ConferenciaCD")
  conferenciasRemetente Conferencia[]  @relation("ConferenciaRemetente")
  agendas              AgendaDevolucao[]
  compras              Compra[]
  auditorias           Auditoria[]

  @@index([tipo, ativo])
}

model Fornecedor {
  id       String   @id @default(cuid())
  nome     String
  cnpj     String   @unique // normalizado: 14 caracteres (numérico ou alfanumérico)
  contato  String?
  telefone String?
  email    String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  vales         ValePallet[]
  movimentacoes Movimentacao[]
  agendas       AgendaDevolucao[]
  compras       Compra[]
}

model Transportadora {
  id       String   @id @default(cuid())
  nome     String
  cnpj     String   @unique
  contato  String?
  telefone String?
  email    String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())
}

/// Compra de pallets novos, identificada pela chave de acesso da NF-e.
model Compra {
  id           String   @id @default(cuid())
  cdId         String
  chaveAcesso  String   @unique
  notaFiscal   String
  serie        String
  fornecedorId String
  quantidade   Int
  observacao   String?
  criadoEm     DateTime @default(now())
  usuarioId    String

  cd            CentroDistribuicao @relation(fields: [cdId], references: [id])
  fornecedor    Fornecedor     @relation(fields: [fornecedorId], references: [id])
  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  movimentacoes Movimentacao[]
}

/// Vale-pallet. ENVIO: transferência da unidade emissora (cdId) para a unidade destino
/// (unidadeId), em trânsito até a conferência. OCORRENCIA: falta/sobra apurada na
/// conferência (cdId = remetente, unidadeId = recebedor). FORNECEDOR: módulo de fornecedores.
model ValePallet {
  id                  String     @id @default(cuid())
  numero              Int        @unique @default(autoincrement())
  tipo                TipoVale
  ocorrencia          TipoOcorrencia?
  /// Unidade emissora (envio) ou remetente (ocorrência) ou recebedora (fornecedor).
  cdId                String
  /// Unidade destino (envio) ou recebedora (ocorrência).
  unidadeId           String?
  fornecedorId        String?
  quantidadeBons      Int        @default(0)
  quantidadeQuebrados Int        @default(0)
  /// Total do vale (bons + quebrados).
  quantidade          Int
  transportadora      String?
  placa               String?
  rota                String?
  dataFaturamento     DateTime?  @db.Date
  notaFiscal          String?
  serieNf             String?
  chaveNfe            String?    @unique
  semNotaFiscal       Boolean    @default(false)
  conferente          String?
  status              StatusVale @default(PENDENTE)
  observacao          String?
  criadoEm            DateTime   @default(now())
  criadoPorId         String
  agendaId            String?
  finalizadoEm        DateTime?
  /// Conferência em que o vale de envio foi recebido.
  conferenciaId       String?
  /// Conferência que gerou o vale de ocorrência.
  conferenciaOrigemId String?
  resolucao           ResolucaoOcorrencia?
  resolvidoEm         DateTime?
  resolvidoPorId      String?
  observacaoResolucao String?
  canceladoEm            DateTime?
  canceladoPorId         String?
  motivoCancelamento     MotivoCancelamento?
  observacaoCancelamento String?

  cd                CentroDistribuicao  @relation("ValeCD", fields: [cdId], references: [id])
  unidade           CentroDistribuicao? @relation("ValeUnidade", fields: [unidadeId], references: [id])
  fornecedor        Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  criadoPor         Usuario          @relation("ValeCriadoPor", fields: [criadoPorId], references: [id])
  canceladoPor      Usuario?         @relation("ValeCanceladoPor", fields: [canceladoPorId], references: [id])
  resolvidoPor      Usuario?         @relation("ValeResolvidoPor", fields: [resolvidoPorId], references: [id])
  agenda            AgendaDevolucao? @relation(fields: [agendaId], references: [id])
  conferencia       Conferencia?     @relation("ValesConferencia", fields: [conferenciaId], references: [id])
  conferenciaOrigem Conferencia?     @relation("OcorrenciasConferencia", fields: [conferenciaOrigemId], references: [id])
  movimentacoes     Movimentacao[]

  @@index([status])
  @@index([cdId, tipo, status])
  @@index([unidadeId, tipo, status])
  @@index([fornecedorId, status])
}

/// Conferência de recebimento: vales de um remetente x contagem física (bons e quebrados).
model Conferencia {
  id                String   @id @default(cuid())
  numero            Int      @unique @default(autoincrement())
  /// Unidade que recebeu e conferiu.
  cdId              String
  /// Unidade que enviou.
  remetenteId       String
  totalDeclarado    Int
  recebidoBons      Int
  recebidoQuebrados Int
  /// Recebido − declarado (negativo = falta, positivo = sobra).
  diferenca         Int      @default(0)
  placa             String?
  transportadora    String?
  observacao        String?
  criadoEm          DateTime @default(now())
  usuarioId         String

  cd          CentroDistribuicao @relation("ConferenciaCD", fields: [cdId], references: [id])
  remetente   CentroDistribuicao @relation("ConferenciaRemetente", fields: [remetenteId], references: [id])
  usuario     Usuario            @relation(fields: [usuarioId], references: [id])
  vales       ValePallet[]       @relation("ValesConferencia")
  ocorrencias ValePallet[]       @relation("OcorrenciasConferencia")
  movimentacoes Movimentacao[]

  @@index([cdId, criadoEm])
  @@index([remetenteId, criadoEm])
}

/// Agenda de devolução a fornecedor (módulo Recebimento Pallet Fornecedor).
model AgendaDevolucao {
  id              String       @id @default(cuid())
  numero          Int          @unique @default(autoincrement())
  cdId            String
  fornecedorId    String
  dataPrevista    DateTime
  status          StatusAgenda @default(ABERTA)
  observacao      String?
  criadoEm        DateTime     @default(now())
  criadoPorId     String
  validadoEm      DateTime?
  validadoPorId   String?
  canceladoEm     DateTime?

  cd            CentroDistribuicao @relation(fields: [cdId], references: [id])
  fornecedor    Fornecedor     @relation(fields: [fornecedorId], references: [id])
  criadoPor     Usuario        @relation("AgendaCriadaPor", fields: [criadoPorId], references: [id])
  validadoPor   Usuario?       @relation("AgendaValidadaPor", fields: [validadoPorId], references: [id])
  vales         ValePallet[]
  movimentacoes Movimentacao[]

  @@index([status])
  @@index([cdId, dataPrevista])
}

/// Livro-razão por unidade (cdId). Imutável (gatilhos no banco).
model Movimentacao {
  id            String           @id @default(cuid())
  tipo          TipoMovimentacao
  quantidade    Int
  origem        Conta
  destino       Conta
  observacao    String?
  motivo        String?
  criadoEm      DateTime         @default(now())
  usuarioId     String
  /// Unidade dona do lançamento.
  cdId          String
  /// Outra unidade envolvida (destino do envio, remetente do recebimento).
  unidadeId     String?
  fornecedorId  String?
  valeId        String?
  agendaId      String?
  compraId      String?
  conferenciaId String?

  usuario     Usuario             @relation(fields: [usuarioId], references: [id])
  cd          CentroDistribuicao  @relation("MovimentacaoCD", fields: [cdId], references: [id])
  unidade     CentroDistribuicao? @relation("MovimentacaoUnidade", fields: [unidadeId], references: [id])
  compra      Compra?             @relation(fields: [compraId], references: [id])
  fornecedor  Fornecedor?         @relation(fields: [fornecedorId], references: [id])
  vale        ValePallet?         @relation(fields: [valeId], references: [id])
  agenda      AgendaDevolucao?    @relation(fields: [agendaId], references: [id])
  conferencia Conferencia?        @relation(fields: [conferenciaId], references: [id])

  @@index([criadoEm])
  @@index([tipo, criadoEm])
  @@index([cdId, criadoEm])
  @@index([cdId, origem])
  @@index([cdId, destino])
}

/// Trilha de auditoria imutável (gatilhos no banco bloqueiam UPDATE/DELETE).
model Auditoria {
  id         String   @id @default(cuid())
  acao       String
  entidade   String
  entidadeId String?
  origem     Conta?
  destino    Conta?
  quantidade Int?
  observacao String?
  detalhes   Json?
  criadoEm   DateTime @default(now())
  usuarioId  String?
  cdId       String?

  usuario Usuario?            @relation(fields: [usuarioId], references: [id])
  cd      CentroDistribuicao? @relation(fields: [cdId], references: [id])

  @@index([criadoEm])
  @@index([acao])
  @@index([usuarioId])
  @@index([cdId, criadoEm])
}

/// Tokens de sessão encerrados pelo botão Sair.
model SessaoRevogada {
  jti       String   @id
  usuarioId String
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@index([expiraEm])
}
