# PostgreSQL (na Vercel use Neon / Vercel Postgres).
# DATABASE_URL: conexão "pooled" usada pela aplicação.
# DATABASE_URL_UNPOOLED: conexão direta usada pelas migrações.
# A integração Neon da Vercel cria as duas variáveis automaticamente.
DATABASE_URL="postgresql://pallet:pallet@localhost:5432/pallet?schema=public"
DATABASE_URL_UNPOOLED="postgresql://pallet:pallet@localhost:5432/pallet?schema=public"

# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-este-segredo-por-um-valor-aleatorio-longo"

# Usuário administrador criado no primeiro deploy (somente se não existir nenhum usuário)
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="admin123"
